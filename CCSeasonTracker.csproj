<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CCSeasonTracker</AssemblyName>
    <RootNamespace>CCSeasonTracker</RootNamespace>
    <Version>1.0.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Auto-references SDV 1.6.x + SMAPI assemblies and copies assets/i18n into the mod folder -->
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>
  <Target Name="CheckRoomsPng" BeforeTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)checkpng.ps1&quot;" IgnoreExitCode="false" />
  </Target>
</Project>
